# Upstream checkouts the workflow makes at build time. Never commit these:
# they are other people's repositories, and a stale copy here would silently
# out-date the snapshot.
.upstream/

# Build output assembled by the Pages workflow
_site/

# Repo-derived data: regenerated from the source repositories on every workflow
# run, so the committed copy would only ever be stale. data/analysis.js is NOT
# ignored -- it is written by a person and is the only copy there is.
data/snapshot.js

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Editor / OS noise
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/

# Local scratch
*.log
tmp/
